{
  "name": "minecraft-server",
  "version": "1.2.11",
  "description": "Localhost Minecraft control panel with multi-server, playit.gg, and addon catalog support",
  "bin": "src/app.js",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "node src/app.js",
    "start:desktop": "node scripts/start-desktop.cjs",
    "test": "node --check src/app.js && node --check public/app.js && node --check electron/main.cjs && node --check electron/preload.cjs",
    "build:exe": "electron-builder --win dir && node scripts/sync-desktop-runtime.cjs && node scripts/build-launcher-exe.cjs && node scripts/sync-release-assets.cjs win",
    "build:linux": "electron-builder --linux AppImage && node scripts/sync-release-assets.cjs linux",
    "build:mac": "electron-builder --mac dmg zip && node scripts/sync-release-assets.cjs mac"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@vercel/blob": "^2.3.3",
    "archiver": "^7.0.1",
    "express": "^5.2.1",
    "extract-zip": "^2.0.1",
    "minecraft-data": "^3.109.1",
    "pg": "^8.20.0",
    "prismarine-nbt": "^2.7.0",
    "tar": "^7.5.13"
  },
  "devDependencies": {
    "@yao-pkg/pkg": "^6.6.0",
    "electron": "^37.1.0",
    "electron-builder": "^26.0.12"
  },
  "pkg": {
    "assets": [
      "public/**/*"
    ]
  },
  "build": {
    "appId": "local.minecraft.panel",
    "productName": "Releu-minecraft",
    "icon": "build/icon.png",
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false
    },
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "public/**/*",
      "scripts/**/*",
      "src/**/*",
      "package.json",
      "!data/**/*",
      "!servers/**/*",
      "!server/**/*",
      "!backups/**/*",
      "!tools/**/*",
      "!dist/**/*",
      "!MinecraftPanel.exe",
      "!Releu.exe",
      "!Releu-minecraft.exe",
      "!Releu-minecraft.AppImage",
      "!Releu-minecraft-mac.dmg",
      "!Releu-minecraft-mac.zip",
      "!latest-linux.yml",
      "!latest-mac.yml",
      "!*.zip"
    ],
    "asar": false,
    "win": {
      "icon": "build/icon.ico",
      "artifactName": "Releu-minecraft.exe",
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "linux": {
      "icon": "build/icon.png",
      "artifactName": "Releu-minecraft.AppImage",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Game"
    },
    "mac": {
      "icon": "build/icon.icns",
      "artifactName": "Releu-minecraft-mac.${ext}",
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.games"
    }
  }
}
